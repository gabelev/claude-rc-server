# claude-rc configuration. Copy this to claude-rc.env and edit.
# scripts/install.sh does the copy for you on first run.
#
# This file is read in two places:
#   1. The systemd unit loads it as an EnvironmentFile.
#   2. claude-rc.sh sources it directly (so standalone tmux use works too).
#
# NOTE: systemd EnvironmentFile does NOT expand $HOME or other shell variables.
# Leave PROJECTS_DIR commented to use the default ($HOME/projects), or set it to
# an absolute path with no variables.

# Where all repos are cloned. Defaults to $HOME/projects if unset.
# PROJECTS_DIR=/home/youruser/projects

# Max concurrent sessions per repo server. Default 32 upstream; kept low here
# because several servers run at once on one box. Raise per repo as RAM allows.
CAPACITY=6

# Session spawn mode:
#   worktree  -> each session gets its own git worktree (isolated). Needs a git repo.
#   same-dir  -> all sessions share the working directory (can conflict on edits).
#   session   -> single session only, rejects extra connections.
SPAWN=worktree

# Optional bearer token for the Chaos Dimension MCP server. Leave blank if the
# endpoint needs no auth or uses OAuth. If set, scripts/setup-mcp.sh wires it in
# as a header that expands at runtime, so the secret never lands in ~/.claude.json.
CHAOS_DIMENSION_TOKEN=
